# API do Nomus (somente leitura). O token é a credencial Basic já em base64.
NOMUS_BASE_URL=""
NOMUS_TOKEN=""

# Alternativa a preencher os dois acima: caminho de um .env que já tenha NOMUS_BASE_URL e NOMUS_TOKEN
# (ex.: o do Gferro-PCP). Assim a credencial não é copiada para cá.
# NOMUS_ENV_FILE="C:/Users/Admin/Documents/Gferro-PCP/.env"

# itensPedido[].status = Liberado (1 = Aguardando liberação, 2 = Liberado)
NOMUS_STATUS_LIBERADO="2"

# A instância do Nomus é compartilhada com a Constelha: contas a receber só da GFERRO.
NOMUS_ID_EMPRESA="3"

NOMUS_LOCAL_DB="data/nomus-local.sqlite"

# A tela de pedidos em aberto esconde pedidos com número abaixo deste.
NOMUS_PEDIDO_MINIMO="1280"

# Assistente de IA (xAI / Grok). A chave NÃO vai neste arquivo de exemplo: coloque no .env (não versionado).
GROK_API_KEY=""
GROK_MODELO=""
# GROK_BASE_URL="https://api.x.ai/v1"
# ASSISTENTE_LIMITE_DIARIO="200"
